{
	"name": "cris-chaves-imoveis",
	"description": "Site imobiliário e área administrativa de Cris Chaves.",
	"dependencies": {
		"@fontsource-variable/geist": "5.3.0",
		"@fontsource-variable/geist-mono": "5.3.0",
		"@supabase/ssr": "0.12.5",
		"@supabase/supabase-js": "2.114.0",
		"isbot": "5.1.32",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-router": "8.3.1",
		"zod": "4.5.4"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@cloudflare/vite-plugin": "1.54.3",
		"@eslint/js": "9.39.5",
		"@playwright/test": "1.62.1",
		"@react-router/dev": "8.3.1",
		"@testing-library/dom": "10.4.1",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.7",
		"@types/node": "24.10.1",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"@vitest/coverage-v8": "4.1.11",
		"eslint": "9.39.5",
		"eslint-plugin-jsx-a11y": "6.10.2",
		"eslint-plugin-react-hooks": "7.1.1",
		"globals": "17.12.0",
		"jsdom": "30.0.1",
		"prettier": "3.9.6",
		"supabase": "2.116.0",
		"typescript": "5.9.3",
		"typescript-eslint": "8.69.0",
		"vite": "8.2.2",
		"vitest": "4.1.11",
		"wrangler": "4.128.0"
	},
	"engines": {
		"node": ">=24 <25",
		"pnpm": ">=11 <12"
	},
	"packageManager": "pnpm@11.19.0",
	"private": true,
	"scripts": {
		"audit:dependencies": "pnpm audit --audit-level high",
		"build": "react-router build",
		"build:e2e": "node scripts/build-e2e.mjs",
		"bootstrap:first-owner": "node scripts/bootstrap-first-owner.mjs",
		"cf-typegen": "wrangler types && react-router typegen",
		"check": "pnpm check:sensitive-data && pnpm check:stage2-security && pnpm audit:dependencies && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit:coverage && pnpm test:integration:publication && pnpm build && pnpm check:client-boundary && pnpm check:cloudflare && pnpm test:e2e",
		"check:client-boundary": "node scripts/check-client-boundaries.mjs --require-build",
		"check:cloudflare": "wrangler deploy --dry-run",
		"check:sensitive-data": "node scripts/check-sensitive-data.mjs",
		"check:stage2-security": "node scripts/check-stage2-security.mjs",
		"deploy": "wrangler deploy",
		"dev": "react-router dev",
		"db:lint": "supabase db lint --local --level error",
		"db:reset": "supabase db reset",
		"db:test": "supabase test db",
		"db:types": "supabase gen types --lang typescript --local --schema public > app/lib/supabase/database.types.ts",
		"format": "prettier . --write --ignore-unknown",
		"format:check": "prettier . --check --ignore-unknown",
		"lint": "pnpm typegen && eslint . --max-warnings=0",
		"preview": "vite preview",
		"preview:node": "node scripts/serve-built-local.mjs",
		"supabase:start": "supabase start",
		"supabase:stop": "supabase stop",
		"test": "vitest run",
		"test:e2e": "pnpm build:e2e && playwright test",
		"test:integration:publication": "node tests/integration/publication-contract.test.mjs",
		"test:unit": "vitest run",
		"test:unit:coverage": "vitest run --coverage",
		"typecheck": "pnpm typegen && tsc -b && tsc -p tests/tsconfig.json",
		"typegen": "react-router typegen"
	},
	"type": "module"
}
