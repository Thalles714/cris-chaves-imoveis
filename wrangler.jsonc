/**
 * Cloudflare Workers configuration for the project foundation.
 * Secrets must be created with `wrangler secret put` and never committed.
 * Free-plan limits: https://developers.cloudflare.com/workers/platform/limits/
 */
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "cris-chaves-imoveis",
	"main": "./workers/app.ts",
	"workers_dev": false,
	"preview_urls": false,
	"compatibility_date": "2026-08-31",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"APP_ENV": "production",
		"PUBLIC_SITE_URL": "https://crischaves.com.br",
		"PUBLIC_WHATSAPP_NUMBER": "5551999996129",
		"PUBLIC_CRECI": "CRECI-RS 89448",
	},
	"secrets": {
		"required": ["SUPABASE_URL", "SUPABASE_PUBLISHABLE_KEY", "SUPABASE_SECRET_KEY"],
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 0.1,
		"redact_query_string": true,
		"logs": {
			"invocation_logs": true,
			"persist": false,
		},
		"traces": {
			"enabled": false,
			"persist": false,
		},
	},
	"ratelimits": [
		{
			"name": "CONTACT_RATE_LIMITER",
			"namespace_id": "2468031",
			"simple": {
				"limit": 5,
				"period": 60,
			},
		},
		{
			"name": "ADMIN_AUTH_RATE_LIMITER",
			"namespace_id": "2468033",
			"simple": {
				"limit": 8,
				"period": 60,
			},
		},
		{
			"name": "ADMIN_MUTATION_RATE_LIMITER",
			"namespace_id": "2468034",
			"simple": {
				"limit": 30,
				"period": 60,
			},
		},
	],
	"env": {
		"staging": {
			"workers_dev": true,
			"preview_urls": false,
			"secrets": {
				"required": ["SUPABASE_URL", "SUPABASE_PUBLISHABLE_KEY", "SUPABASE_SECRET_KEY"],
			},
			"vars": {
				"APP_ENV": "preview",
				"PUBLIC_WHATSAPP_NUMBER": "5551999996129",
				"PUBLIC_CRECI": "CRECI-RS 89448",
			},
			"ratelimits": [
				{
					"name": "CONTACT_RATE_LIMITER",
					"namespace_id": "2468037",
					"simple": {
						"limit": 5,
						"period": 60,
					},
				},
				{
					"name": "ADMIN_AUTH_RATE_LIMITER",
					"namespace_id": "2468038",
					"simple": {
						"limit": 8,
						"period": 60,
					},
				},
				{
					"name": "ADMIN_MUTATION_RATE_LIMITER",
					"namespace_id": "2468039",
					"simple": {
						"limit": 30,
						"period": 60,
					},
				},
			],
		},
		"test": {
			"vars": {
				"APP_ENV": "test",
				"PUBLIC_WHATSAPP_NUMBER": "5551999996129",
				"PUBLIC_CRECI": "CRECI-RS 89448",
			},
			"ratelimits": [
				{
					"name": "CONTACT_RATE_LIMITER",
					"namespace_id": "2468032",
					"simple": {
						"limit": 5,
						"period": 60,
					},
				},
				{
					"name": "ADMIN_AUTH_RATE_LIMITER",
					"namespace_id": "2468035",
					"simple": {
						"limit": 1000,
						"period": 60,
					},
				},
				{
					"name": "ADMIN_MUTATION_RATE_LIMITER",
					"namespace_id": "2468036",
					"simple": {
						"limit": 1000,
						"period": 60,
					},
				},
			],
		},
	},
	"upload_source_maps": true,
}
